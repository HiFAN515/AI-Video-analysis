# VideoMind environment defaults (the web UI settings override these at runtime)
VM_HOST=127.0.0.1
VM_PORT=7860

# Optional: point data/model dirs elsewhere (absolute paths recommended)
# VM_DATA_DIR=/path/to/videomind-data
# VM_MODEL_DIR=/path/to/videomind-models

# LLM (OpenAI compatible): DeepSeek / OpenAI / Qwen / Ollama / ...
VM_LLM_BASE_URL=https://api.deepseek.com/v1
VM_LLM_API_KEY=
VM_LLM_MODEL=deepseek-chat
VM_LLM_TEMPERATURE=0.3

# Speech recognition
VM_ASR_BACKEND=local
VM_ASR_MODEL=small
VM_ASR_DEVICE=cpu
VM_ASR_COMPUTE_TYPE=int8
VM_ASR_LANGUAGE=auto

# Optional cloud ASR (OpenAI compatible /audio/transcriptions)
VM_CLOUD_ASR_BASE_URL=https://api.openai.com/v1
VM_CLOUD_ASR_API_KEY=
VM_CLOUD_ASR_MODEL=whisper-1

# Audio pipeline defaults
VM_BGM_SEPARATION=true
VM_DENOISE=true
VM_DIARIZATION_ENABLED=true
VM_DIARIZATION_MAX_SPEAKERS=0
VM_DIARIZATION_THRESHOLD=0.5
VM_DEFAULT_DELETE_AUDIO=false

# Downloads
# VM_PROXY=http://127.0.0.1:1080
# VM_COOKIES_FILE=/path/to/cookies.txt
VM_MAX_CONCURRENT_JOBS=1
